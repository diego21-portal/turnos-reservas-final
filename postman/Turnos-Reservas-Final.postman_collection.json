{
  "info": {
    "_postman_id": "9fd7cf28-84ec-4ebd-8eb8-correccion-final",
    "name": "Turnos y Reservas - Corrección Final",
    "description": "Colección para verificar CRUD, consultas avanzadas, Zod, ObjectId, populate e incremento de quantity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Crear servicio Salud",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Consulta final\",\n  \"description\": \"Servicio creado para la corrección final.\",\n  \"category\": \"Salud\",\n  \"price\": 15000,\n  \"duration\": 45,\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.expect(j.payload).to.have.property(\"_id\");",
              "pm.collectionVariables.set(\"serviceId\", j.payload._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Filtros + paginación + sort + category case-insensitive",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services?page=1&limit=5&category=salud&available=true&minPrice=1000&maxPrice=50000&sort=asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"Paginación\", () => { pm.expect(j).to.have.property(\"totalPages\"); pm.expect(j.page).to.eql(1); pm.expect(j.limit).to.eql(5); });",
              "pm.test(\"Category sin distinguir mayúsculas\", () => { pm.expect(j.payload.some(x => x._id === pm.collectionVariables.get(\"serviceId\"))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services/{{serviceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Actualizar servicio",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 16500,\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Crear reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Cliente Corrección\",\n  \"customerEmail\": \"cliente@example.com\",\n  \"scheduledAt\": \"2026-08-25T15:00:00.000Z\",\n  \"notes\": \"Reserva para verificar la rúbrica\",\n  \"services\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"bookingId\", j.payload._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Agregar servicio quantity 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "const id = pm.collectionVariables.get(\"serviceId\");",
              "const item = j.payload.services.find(x => (x.service?._id || x.service) === id);",
              "pm.test(\"quantity = 2\", () => pm.expect(item.quantity).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Repetir servicio e incrementar quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 (no 409)\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "const id = pm.collectionVariables.get(\"serviceId\");",
              "const matches = j.payload.services.filter(x => (x.service?._id || x.service) === id);",
              "pm.test(\"No duplica el servicio\", () => pm.expect(matches.length).to.eql(1));",
              "pm.test(\"quantity = 3\", () => pm.expect(matches[0].quantity).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - GET principal con populate",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"Servicio poblado\", () => { pm.expect(j.payload.services[0].service).to.be.an(\"object\"); pm.expect(j.payload.services[0].service).to.have.property(\"name\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Alias populated",
      "request": {
