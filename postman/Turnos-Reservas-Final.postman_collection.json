    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "01 - Crear servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Servicio Postman Final\",\n  \"description\": \"Servicio creado automáticamente desde la colección de pruebas.\",\n  \"category\": \"Pruebas\",\n  \"price\": 15000,\n  \"duration\": 45,\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "if (json.payload && json.payload._id) pm.collectionVariables.set(\"serviceId\", json.payload._id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Listar servicios con filtros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services?page=1&limit=5&available=true&minPrice=1000&maxPrice=50000&sort=asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta paginada\", function () { const j=pm.response.json(); pm.expect(j).to.have.property(\"totalPages\"); pm.expect(j.payload).to.be.an(\"array\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
